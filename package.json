{
  "name": "nx-fork-manager-gui",
  "version": "1.0.0",
  "description": "Modern Windows desktop GUI for nx-fork-manager - Switch emulator fork manager & game recommendation guide",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist:zip": "electron-builder --win zip",
    "dist:portable": "electron-builder --win portable",
    "dist:dir": "electron-builder --dir"
  },
  "build": {
    "appId": "com.nx-fork-manager.gui",
    "productName": "NX Fork Manager",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "zip",
        "nsis"
      ],
      "artifactName": "${productName}-${version}-windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "package.json"
    ],
    "extraFiles": [
      "fork-manager.ps1",
      "forks.json",
      "ForkManager.cmd",
      "LICENSE",
      "README.md"
    ]
  },
  "keywords": [
    "switch",
    "emulator",
    "fork-manager",
    "gui",
    "wichforks"
  ],
  "author": "Antigravity & Schroederr",
  "license": "MIT",
  "dependencies": {
    "marked": "^15.0.7"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  }
}
